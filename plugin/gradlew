#!/usr/bin/env sh

# Minimal Gradle wrapper launcher. If gradle-wrapper.jar is missing, run
# `gradle wrapper --gradle-version 8.10.2` once to regenerate it, then use
# the regular `./gradlew` afterwards.

set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
WRAPPER_JAR="$DIR/gradle/wrapper/gradle-wrapper.jar"

if [ ! -f "$WRAPPER_JAR" ]; then
  echo "gradle-wrapper.jar is missing. Bootstrap it with:" >&2
  echo "  (cd \"$DIR\" && gradle wrapper --gradle-version 8.10.2)" >&2
  echo "Or run builds through the Gradle tooling directly." >&2
  exit 1
fi

exec java -classpath "$WRAPPER_JAR" org.gradle.wrapper.GradleWrapperMain "$@"
