{
  "name": "rubberduck-live-vscode",
  "displayName": "RubberDuck Live",
  "description": "AI pair programmer that watches you think — Socratic questions, test generation, refactor suggestions.",
  "version": "0.1.0",
  "publisher": "rubberduck-live",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "rubberduck.generateTests",           "title": "🦆 RubberDuck: Generate Tests" },
      { "command": "rubberduck.suggestRefactor",         "title": "🦆 RubberDuck: Suggest Refactor" },
      { "command": "rubberduck.openDashboard",           "title": "🦆 RubberDuck: Open Dashboard (browser)" },
      { "command": "rubberduck.testConnection",          "title": "🦆 RubberDuck: Test Connection" },
      { "command": "rubberDuck.showDashboard",           "title": "🦆 RubberDuck: Show Dashboard (in editor)" },
      { "command": "rubberDuck.explainOldCode",          "title": "🦆 RubberDuck: Explain Old Code" },
      { "command": "rubberduck.chat.open",               "title": "🦆 RubberDuck: Open Chat",               "category": "RubberDuck" },
      { "command": "rubberduck.chat.newChat",            "title": "🦆 RubberDuck: New Chat",                "category": "RubberDuck" },
      { "command": "rubberduck.chat.focus",              "title": "🦆 RubberDuck: Focus Chat Input",        "category": "RubberDuck" },
      { "command": "rubberduck.chat.stop",               "title": "🦆 RubberDuck: Stop Generation",         "category": "RubberDuck" },
      { "command": "rubberduck.chat.clear",              "title": "🦆 RubberDuck: Clear Chat",              "category": "RubberDuck" },
      { "command": "rubberduck.chat.attachSelection",    "title": "🦆 RubberDuck: Attach Selection to Chat","category": "RubberDuck" },
      { "command": "rubberduck.chat.sendSelection",      "title": "🦆 RubberDuck: Ask About Selection",     "category": "RubberDuck" }
    ],
    "keybindings": [
      { "command": "rubberduck.chat.newChat", "key": "ctrl+alt+shift+n", "mac": "cmd+alt+shift+n", "when": "focusedView == rubberduck.chat" },
      { "command": "rubberduck.chat.focus",   "key": "ctrl+alt+shift+k", "mac": "cmd+alt+shift+k" }
    ],
    "menus": {
      "editor/context": [
        { "command": "rubberduck.generateTests",        "group": "rubberduck@1", "when": "editorHasSelection || editorTextFocus" },
        { "command": "rubberduck.suggestRefactor",      "group": "rubberduck@2", "when": "editorTextFocus" },
        { "command": "rubberDuck.explainOldCode",       "group": "rubberduck@3", "when": "editorTextFocus" },
        { "command": "rubberduck.chat.attachSelection", "group": "rubberduck@4", "when": "editorHasSelection" },
        { "command": "rubberduck.chat.sendSelection",   "group": "rubberduck@5", "when": "editorHasSelection" }
      ]
    },
    "configuration": {
      "title": "RubberDuck Live",
      "properties": {
        "rubberduckLive.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765",
          "description": "Base URL of the RubberDuck Live backend (FastAPI)."
        },
        "rubberduckLive.sendEventsToDashboard": {
          "type": "boolean",
          "default": true,
          "description": "Forward developer events over WebSocket to the dashboard."
        },
        "rubberduckLive.interventionFrequency": {
          "type": "string",
          "enum": ["MINIMAL", "NORMAL", "CHATTY"],
          "default": "NORMAL",
          "description": "How often Socratic interventions are allowed to fire."
        },
        "rubberduckLive.privacyMode": {
          "type": "boolean",
          "default": false,
          "description": "Strict: never send code off-device. Disables Generate Tests + Suggest Refactor."
        },
        "rubberduckLive.dashboardUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL opened by 🦆 RubberDuck: Open Dashboard."
        },
        "rubberduckLive.enableInlineCompletion": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI ghost-text completion (calls POST /api/v1/complete). Disable to silence inline suggestions."
        },
        "rubberduck.backendBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8765/api/v1",
          "description": "Base URL used by the chat web UI for its direct SSE fetch to the backend."
        },
        "rubberduck.chatModel": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Default model pre-selected in the chat composer."
        },
        "rubberduck.chatAvailableModels": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["gpt-4o-mini", "gpt-4o", "claude-sonnet-4", "ollama/llama3.1"],
          "description": "Models offered in the chat model picker."
        },
        "rubberduck.chatMaxHistoryTokens": {
          "type": "integer",
          "default": 8000,
          "description": "Soft cap on how many tokens of chat history are kept in flight."
        },
        "rubberduck.chatAttachOpenFiles": {
          "type": "boolean",
          "default": false,
          "description": "Auto-attach the list of open files to every chat turn."
        },
        "rubberduck.chatAttachDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Auto-attach current diagnostics to every chat turn."
        },
        "rubberduck.enabledSkills": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["Test Generator", "Refactor Suggester", "Code Explainer", "Socratic Coach"],
          "description": "Names of skills (as declared in SKILL.md frontmatter `name:`) that are exposed in the chat @ menu."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        { "id": "rubberduck-live", "title": "RubberDuck Live", "icon": "icon.png" }
      ]
    },
    "views": {
      "rubberduck-live": [
        { "id": "rubberduck.chat",      "name": "Chat",         "type": "webview", "contextualTitle": "RubberDuck Chat", "visibility": "visible" },
        { "id": "rubberduck.dashboard", "name": "Dashboard",    "type": "webview" },
        { "id": "rubberduck.events",    "name": "Recent Events" },
        { "id": "rubberduck.socratic",  "name": "Socratic Feed" }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -w -p .",
    "lint": "eslint src --ext .ts --max-warnings=0",
    "test": "vitest run",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@types/ws": "^8.5.12",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "uuid": "^10.0.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.3.0"
  }
}
