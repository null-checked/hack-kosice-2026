# Dashboard env — copy to `.env.local` (gitignored) and tweak.
#
# The dashboard derives its backend URLs from these three vars in priority order:
#   1. `NEXT_PUBLIC_BACKEND_WS_URL` / `NEXT_PUBLIC_BACKEND_HTTP_URL`
#      — full overrides (handy for SSH tunnels, different schemes, etc.).
#   2. `NEXT_PUBLIC_BACKEND_HOST` + `NEXT_PUBLIC_BACKEND_PORT`
#      — host+port parts, URLs composed at runtime. Keep these in sync with
#        `backend/.env`'s APP_HOST / APP_PORT so the dashboard talks to the
#        same backend the plugin does.
#   3. Fallbacks: 127.0.0.1:8765 (stock dev setup).
#
# Only vars prefixed `NEXT_PUBLIC_` are visible to browser code.

NEXT_PUBLIC_BACKEND_HOST=127.0.0.1
NEXT_PUBLIC_BACKEND_PORT=8765

# Optional full-URL overrides (leave blank to derive from HOST+PORT above):
# NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8765/api/v1/events
# NEXT_PUBLIC_BACKEND_HTTP_URL=http://127.0.0.1:8765/api/v1
