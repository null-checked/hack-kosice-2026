# RubberDuck Live backend — environment variables
# Copy to `.env` and tweak as needed. Every var is optional; sensible defaults
# are applied when they are left unset.

# ---- Server ----
APP_HOST=127.0.0.1
APP_PORT=8765
RELOAD=false
LOG_LEVEL=INFO

# ---- Demo mode ----
# When set to 1/true, all AI endpoints return pre-canned fixtures (no LLM
# calls). Handy for recording demos and running offline.
DEMO_MOCK=0

# ---- LLM provider selection ----
#
# Default stack is **OpenAI official** (`gpt-4o-mini`). The hackathon organiser
# supplies an API key, so this is the zero-setup path. Swap to `ollama` for
# a fully offline / privacy-first run, or `openai_compatible` for LM Studio,
# vLLM, Groq, Together, etc.
#
# One of: openai | openai_compatible | ollama
LLM_PROVIDER=openai

# If the primary provider above can't be reached at request time, try these
# providers in order (the primary is always attempted first). Set to "false"
# to disable fallback entirely.
LLM_FALLBACK=true
LLM_FALLBACK_CHAIN=["openai","openai_compatible","ollama"]

# ---- OpenAI (official) — DEFAULT ----
# The only line you *have* to set is the API key. Model defaults to
# `gpt-4o-mini` which is fast, cheap, and strong enough for our three
# endpoints. Override `OPENAI_MODEL` if you want to try `gpt-4o` or similar.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- OpenAI-compatible (LM Studio / vLLM / Together / Groq / …) ----
# Set BOTH vars to use a self-hosted or third-party OpenAI-shaped endpoint.
# When `OPENAI_BASE_URL` is unset this block is ignored and the official
# OpenAI client is used instead.
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# (reuses OPENAI_API_KEY above; use "sk-local" or similar for LM Studio)

# ---- Ollama (local, privacy-first fallback) ----
# Used when LLM_PROVIDER=ollama, or as a fallback when the cloud providers
# are unreachable. Requires `ollama` running on :11434 with the model pulled.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- Security (optional no-op scaffold) ----
# If set, incoming HTTP requests must include `X-RubberDuck-Token: <value>`.
# Leave unset for local-only development.
# RUBBERDUCK_TOKEN=

# ---- Multi-agent orchestrator (for /chat with mode="agent") ----------------
#
# Applies ONLY to `POST /api/v1/chat` when the request sets `mode="agent"`
# (selected via the Ask/Edit/Agent dropdown in the chat composer). The
# "ask" and "edit" modes are NOT affected.
#
# !! PRIVACY WARNING !!
# Enabling the orchestrator deliberately relaxes four of the privacy
# invariants in the root CLAUDE.md: outbound DuckDuckGo calls, unsandboxed
# filesystem read+write of the work dir, unsandboxed shell execution, and
# un-redacted paths on the orchestrator request. Read
# `backend/docs/PRIVACY_NOTES.md` BEFORE setting `ORCHESTRATOR_ENABLED=true`
# on a machine you care about.
#
# The orchestrator only builds on OpenAI / OpenAI-compatible providers.
# Under Ollama, `/chat mode="agent"` returns an error frame even with
# `ORCHESTRATOR_ENABLED=true`.

# Master switch. Set to "false" to disable the orchestrator entirely; ask
# and edit modes always remain available.
ORCHESTRATOR_ENABLED=true

# Optional sub-agent model override. Empty = sub-agents share the
# orchestrator model (OPENAI_MODEL). Set to something cheaper (e.g.
# `gpt-4o-mini`) to split costs while keeping the orchestrator big.
# ORCHESTRATOR_SUBAGENT_MODEL=

# Root directory the shared `LocalShellBackend` operates in. Empty = the
# backend process's current working directory. Sub-agents will
# read/write/edit files under this tree AND shell out to any command —
# make sure it's a repo you're happy for the agent to mutate.
# ORCHESTRATOR_WORK_DIR=

# Per-command shell timeout (seconds). Commands exceeding this are killed.
ORCHESTRATOR_SHELL_TIMEOUT=120

# Maximum captured stdout+stderr bytes returned to the agent per `execute`
# call. Beyond this, output is truncated. Prevents a runaway command from
# blowing out the LLM context window.
ORCHESTRATOR_SHELL_MAX_OUTPUT_BYTES=100000

# DuckDuckGo internet search tool availability. Set to "false" to strip
# the `internet_search` tool from all agents. Disabling is recommended on
# air-gapped machines or when you don't want DuckDuckGo to see your queries.
ORCHESTRATOR_WEB_SEARCH_ENABLED=true

# LangSmith tracing — we keep it off (no phoning home).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_CALLBACKS_BACKGROUND=false
LANGSMITH_TRACING=false
