# RubberDuck Live backend — environment variables
# Copy to `.env` and tweak as needed. All are optional.

# ---- Server ----
APP_HOST=127.0.0.1
APP_PORT=8765
RELOAD=false
LOG_LEVEL=INFO

# ---- Demo mode ----
# When set to 1/true, all AI endpoints return pre-canned fixtures (no LLM calls).
DEMO_MOCK=0

# ---- LLM provider selection ----
# One of: ollama | openai_compatible | openai
LLM_PROVIDER=ollama

# Fallback order if primary fails: ollama -> openai_compatible -> openai
# Set to "false" to disable fallback.
LLM_FALLBACK=true

# ---- Ollama (default, local) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ---- OpenAI-compatible (LM Studio / vLLM / Together / Groq / etc.) ----
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=sk-local

# ---- OpenAI (official) ----
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ---- Security (optional no-op scaffold) ----
# If set, incoming HTTP requests must include `X-RubberDuck-Token: <value>`.
# Leave unset for local-only development.
# RUBBERDUCK_TOKEN=
