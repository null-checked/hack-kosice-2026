# 🦆 RubberDuck Live — root env example
#
# This is a *consolidated* reference. Each subsystem has its own .env.example
# that takes precedence for its own variables:
#
#   - backend/.env.example     (FastAPI + LLM provider)
#   - dashboard/.env.example   (Next.js public env)
#   - plugin/...               (plugin is configured via IDE Settings UI,
#                               not env vars)
#
# Copy the two per-subsystem files, not this one, unless you prefer a single
# top-level .env that you source yourself.

# ---------- Backend (see backend/.env.example) ----------
APP_HOST=127.0.0.1
APP_PORT=8765
RELOAD=false
LOG_LEVEL=INFO

# Demo mode: 1 = canned fixtures, 0 = real LLM.
DEMO_MOCK=0

# LLM provider — default is OpenAI official (`gpt-4o-mini`). Switch to
# `ollama` for fully offline / privacy-first, or `openai_compatible` for
# LM Studio / vLLM / Together / Groq / etc.
LLM_PROVIDER=openai
LLM_FALLBACK=true
LLM_FALLBACK_CHAIN=["openai","openai_compatible","ollama"]

# OpenAI official (DEFAULT) — set the API key from the hackathon organiser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible (LM Studio / vLLM / Groq / Together). Reuses OPENAI_API_KEY.
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1

# Ollama (local fallback). Requires `ollama` running on :11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# RUBBERDUCK_TOKEN=

# ---------- Dashboard (see dashboard/.env.example) ----------
NEXT_PUBLIC_BACKEND_WS_URL=ws://127.0.0.1:8765/api/v1/events
NEXT_PUBLIC_BACKEND_HTTP_URL=http://127.0.0.1:8765/api/v1
NEXT_PUBLIC_DEMO_REPLAY=0
